# 이 파일을 .env로 복사해 채우세요. .env에는 비밀번호가 들어가므로 저장소에 올리지 마세요.

# 웹앱 주소 (공유기에서 80·443 포트를 이 컴퓨터로 연결하고, 도메인의 A 레코드를 집 공인 IP로)
DOMAIN=home.example.com

# 결산 리포트 메일 (비우면 메일을 보내지 않음). Gmail은 2단계 인증 후 '앱 비밀번호'를 만들어 넣습니다.
HH_SMTP_HOST=smtp.gmail.com
HH_SMTP_PORT=587
HH_SMTP_USER=
HH_SMTP_PASSWORD=
HH_MAIL_FROM=
HH_MAIL_TO=
# 매월 며칠에 지난달 결산 리포트를 보낼지 (1~28)
REPORT_DAY=3
