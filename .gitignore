.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
output/*.xlsx

# 실전 파이프라인의 실 데이터(공급처/경쟁상품 조사 결과, KAMIS 코드, 송장)는
# 운영자별 민감 정보라 커밋하지 않는다 - *.example.* 템플릿만 버전관리한다.
data/live/*.json
data/live/*.csv
!data/live/*.example.json
!data/live/*.example.csv

# 수동 리서치 상품 선정(product_selection.py)에 채워 넣는 실제 조사 값도 마찬가지.
data/manual/*.json
!data/manual/*.example.json

# 소싱 관리 실데이터(농가 연락처 등 개인정보)와 누적 이력 - 예시 템플릿만 버전관리
data/sourcing/*.csv
!data/sourcing/*.example.csv
# 웹 공개 정보로만 만든 1차 발굴 리스트(연락처 없음)는 공유용으로 버전관리
!data/sourcing/leads.seed.csv

# 마케팅 실데이터(키워드 DB/성과 보고서/인플루언서 연락처)
data/marketing/*.csv
!data/marketing/*.example.csv
data/marketing/keyword_stats.json
data/marketing/shopping_counts.json
output/*.csv
